# Backend host for the Vite dev server proxy (/api, /webhook).
# Falls back to http://localhost:8080 if unset. Dev only — no effect in prod build.
VITE_API_BASE_URL=http://localhost:8080

# Backend host for the browser WebSocket connection (chat thread stream).
# Baked into the client bundle at build time. Must point directly at the backend
# (Cloudflare Pages Functions don't reliably proxy WS). Use ws:// in dev, wss:// in prod.
# Keep host aligned with VITE_API_BASE_URL.
VITE_WS_BASE_URL=ws://localhost:8080

# Published API docs, served by the landing app at /docs/ (built by
# apps/landing/scripts/build-docs.mjs). Settings → API Keys links to it when this
# is set and shows no link when it is not — a dead link is worse than none at the
# moment a tenant has a fresh key and nothing to do with it.
VITE_DOCS_URL=http://localhost:5173/docs/

# Note: the Cloudflare Pages Function reads UPSTREAM_URL from the Pages env binding
# (Settings → Environment variables in the Pages dashboard), not from this file.
