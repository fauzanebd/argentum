# Argentum App Instance — per-tenant configuration.
# Copy to .env and fill in. One App Instance = one tenant.

# Tenant identity (required) — set by the gateway repo's deployment process.
TENANT_ID=acme
TENANT_NAME=Acme Corp

# Runtime
ENV=development
LOG_LEVEL=info
PORT=8080

# Source DB — the client's existing analytics database (read-only target).
# Real deployments point this at the client's external Postgres.
SOURCE_DB_HOST=source_postgres
SOURCE_DB_PORT=5432
SOURCE_DB_USER=analytics
SOURCE_DB_PASSWORD=analytics123
SOURCE_DB_NAME=analytics_db
SOURCE_DB_SSL_MODE=disable

# Internal DB — owned by this App Instance. Stores chat history, jobs,
# vector cache. Migrated automatically on boot.
INTERNAL_DB_HOST=internal_postgres
INTERNAL_DB_PORT=5432
INTERNAL_DB_USER=argentum
INTERNAL_DB_PASSWORD=argentum123
INTERNAL_DB_NAME=argentum_internal
INTERNAL_DB_SSL_MODE=disable

# LLM — primary agent
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Light LLM — used for guardrails / classifier / summary. Leave LIGHT_LLM_API_KEY
# empty to reuse the primary client.
LIGHT_LLM_PROVIDER=gemini
LIGHT_LLM_API_KEY=
LIGHT_LLM_MODEL=gemini-2.5-flash-lite

# WhatsApp pipeline. Off by default — flip to true and fill the WHATSAPP_*
# block to enable async webhook + RabbitMQ + worker.
ENABLE_WHATSAPP=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/

# Object storage (MinIO / S3-compatible). Everything the product hands back as
# a file lives here: generate_document, /v1/reports, and the tenant logo on a
# branded PDF. Leave MINIO_ENDPOINT empty and those paths degrade rather than
# fail — the tool is not registered and /v1/reports/render answers
# `rendering_unavailable` — which is a hard thing to debug if you did not mean
# it.
#
# `make infra` runs one locally on 9000 (console on 9001) with these defaults.
# The bucket is created by whichever process starts first, so there is nothing
# to provision by hand.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=argentum-documents
MINIO_USE_SSL=false

# A hosted S3-compatible provider is the same five variables with different
# values — no code path differs, and this is how the other Go services in this
# workspace are deployed (IDCloudHost, `is3.cloudhost.id`):
#
#   MINIO_ENDPOINT=is3.cloudhost.id
#   MINIO_ACCESS_KEY=…
#   MINIO_SECRET_KEY=…
#   MINIO_BUCKET=argentum
#   MINIO_USE_SSL=true          <- required; the endpoint is https-only
#
# Two things to know before pointing a deployment at a shared account. The
# credentials are account-wide, not bucket-scoped, so a key that can write
# `argentum` can read every other bucket on it — mint a separate one if the
# provider allows it. And downloads stay presigned and time-limited whatever
# the endpoint is: a generated report is a tenant's numbers, and an object
# served public-read is served to anyone who ever saw the link.

# Metabase (optional)
METABASE_URL=http://metabase:3000
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=

# App tuning
CONTEXT_MAX_TURNS=3
HISTORY_HYDRATE_LIMIT=20
MAX_QUERIES_PER_MINUTE=10

# Per-turn agent budget (T-16). Four dimensions, all enforced per chat turn;
# whichever runs out first ends the turn with an explicit incomplete answer
# rather than a fabricated figure. Lowering these does not make the agent
# cheaper so much as blunter — it answers with less evidence.
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TURN_TOKENS=200000
AGENT_TURN_BUDGET_SECS=150

# Credit enforcement (T-03). The balance is checked before a turn is queued on
# every channel and on every scheduled fire; a company at or below zero is
# refused with a 402 and a plain sentence, and nothing is spent.
#
# CREDITS_DEFAULT_GRANT_USD is what a company with no grant is provisioned on
# its first check. It is not optional decoration: nothing else in the system
# ever credits a company, so with a grant of 0 and enforcement on, every tenant
# on platform keys is refused. It is a starting balance, not a monthly refill —
# nothing tops it back up.
#
# A tenant with their own primary key in company_llm_credentials is never
# refused, whatever the balance says. Set ENABLED=false to restore the
# pre-T-03 behaviour: still metered, never refused.
CREDITS_ENFORCEMENT_ENABLED=true
CREDITS_WARNING_THRESHOLD_PCT=20
CREDITS_DEFAULT_GRANT_USD=25

# Public API (T-13). Requests to /v1 authenticate with an API key minted in
# Settings -> API keys, not with a dashboard session.
#
# API_V1_RATE_PER_MIN is a per-key budget in its own Redis bucket, separate
# from the per-company dashboard limiter: a tenant's nightly job and a tenant's
# staff should not be able to exhaust each other. The bucket refills at
# rate/60 per second and bursts to the full minute's budget.
API_V1_RATE_PER_MIN=120

# The kill switch (T-A1). False answers 503 on every /v1 route including
# /v1/me, above authentication, and leaves /api untouched — the dashboard
# keeps working while the public surface is off the air.
API_V1_ENABLED=true

# Caps the synchronous door on /v1/chat (T-A3). A turn runs five to seven tool
# calls; past this the caller gets a resumable 504 carrying the thread id
# rather than a dead connection. Do not raise it when someone complains —
# point them at the SSE stream.
API_V1_SYNC_TIMEOUT_SECONDS=120

# Bounds a /v1 request body. A report spec arriving over HTTP is untrusted in
# a way the agent's own spec never was: refusing to read it is cheaper and
# safer than validating it afterwards.
API_V1_MAX_BODY_BYTES=1048576

# What a posted spec may ask the renderer to lay out (T-A2). The body cap above
# is not enough on its own: 50 000 rows of small integers fit comfortably inside
# a megabyte, and maroto will attempt every one of them. Rows are counted across
# the whole document, not per table.
API_V1_MAX_SPEC_ROWS=50000
API_V1_MAX_SPEC_COLS=40

# How long POST /v1/reports/render holds a connection open before the render
# becomes a job and the caller gets a 202. Distinct from
# API_V1_SYNC_TIMEOUT_SECONDS, which is a chat turn: a render that takes twenty
# seconds is pathological, and a chat turn that takes twenty seconds is Tuesday.
API_V1_SYNC_RENDER_TIMEOUT=20

# Permits a report callback_url pointing at an address only this deployment can
# reach — loopback, RFC1918, link-local — and permits plain http. Leave false
# anywhere it matters: the URL is chosen by the caller, and a POST to
# 169.254.169.254 on their behalf is how an outbound webhook becomes somebody
# else's cloud credentials. True is for local development.
API_V1_CALLBACK_ALLOW_PRIVATE=false

# How often the `/v1` request recorder writes what it has buffered (T-A5). It is
# the staleness of the tenant's own error list traded against the write rate of
# the rollup; the acceptance criterion is "within a minute". A killed process
# loses at most one interval — a clean shutdown flushes.
API_V1_OBS_FLUSH_SECONDS=15

# How long `/v1` request counters and failures are kept. Longer than any
# debugging session, short enough that the tables stay small. Pruned at most
# hourly by whichever API process is running.
API_V1_OBS_RETENTION_DAYS=30

# Gates `/metrics` when set: `Authorization: Bearer <token>`.
#
# Unset serves the endpoint as it always has, minus the per-key block — T-A5
# labels request counters by API key id, and a key id is a tenant's identifier
# for a credential they hold, so it does not go out on an endpoint with no
# credential of its own. An empty value is never a match. Moving `/metrics` off
# the public router entirely is T-17.
METRICS_TOKEN=
