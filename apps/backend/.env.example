# Argentum App Instance — per-tenant configuration.
# Copy to .env and fill in. One App Instance = one tenant.

# Tenant identity (required) — set by the gateway repo's deployment process.
TENANT_ID=acme
TENANT_NAME=Acme Corp

# Runtime
ENV=development
LOG_LEVEL=info
PORT=8080

# Source DB — the client's existing analytics database (read-only target).
# Real deployments point this at the client's external Postgres.
SOURCE_DB_HOST=source_postgres
SOURCE_DB_PORT=5432
SOURCE_DB_USER=analytics
SOURCE_DB_PASSWORD=analytics123
SOURCE_DB_NAME=analytics_db
SOURCE_DB_SSL_MODE=disable

# Internal DB — owned by this App Instance. Stores chat history, jobs,
# vector cache. Migrated automatically on boot.
INTERNAL_DB_HOST=internal_postgres
INTERNAL_DB_PORT=5432
INTERNAL_DB_USER=argentum
INTERNAL_DB_PASSWORD=argentum123
INTERNAL_DB_NAME=argentum_internal
INTERNAL_DB_SSL_MODE=disable

# LLM — primary agent
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Light LLM — used for guardrails / classifier / summary. Leave LIGHT_LLM_API_KEY
# empty to reuse the primary client.
LIGHT_LLM_PROVIDER=gemini
LIGHT_LLM_API_KEY=
LIGHT_LLM_MODEL=gemini-2.5-flash-lite

# WhatsApp pipeline. Off by default — flip to true and fill the WHATSAPP_*
# block to enable async webhook + RabbitMQ + worker.
ENABLE_WHATSAPP=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/

# Metabase (optional)
METABASE_URL=http://metabase:3000
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=

# App tuning
CONTEXT_MAX_TURNS=3
HISTORY_HYDRATE_LIMIT=20
MAX_QUERIES_PER_MINUTE=10

# Per-turn agent budget (T-16). Four dimensions, all enforced per chat turn;
# whichever runs out first ends the turn with an explicit incomplete answer
# rather than a fabricated figure. Lowering these does not make the agent
# cheaper so much as blunter — it answers with less evidence.
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TURN_TOKENS=200000
AGENT_TURN_BUDGET_SECS=150

# Credit enforcement (T-03). The balance is checked before a turn is queued on
# every channel and on every scheduled fire; a company at or below zero is
# refused with a 402 and a plain sentence, and nothing is spent.
#
# CREDITS_DEFAULT_GRANT_USD is what a company with no grant is provisioned on
# its first check. It is not optional decoration: nothing else in the system
# ever credits a company, so with a grant of 0 and enforcement on, every tenant
# on platform keys is refused. It is a starting balance, not a monthly refill —
# nothing tops it back up.
#
# A tenant with their own primary key in company_llm_credentials is never
# refused, whatever the balance says. Set ENABLED=false to restore the
# pre-T-03 behaviour: still metered, never refused.
CREDITS_ENFORCEMENT_ENABLED=true
CREDITS_WARNING_THRESHOLD_PCT=20
CREDITS_DEFAULT_GRANT_USD=25
