{
  "name": "@argentum/widget-react",
  "version": "0.1.0",
  "description": "The Argentum chat widget as a React component. A wrapper around @argentum/widget, not a second implementation of it.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "argentum",
    "widget",
    "embed",
    "react"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@argentum/widget": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
