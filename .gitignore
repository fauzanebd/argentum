# Root-level ignores. Each app keeps its own .gitignore for app-specific
# artifacts — gitignore is hierarchical, so those still apply. This file covers
# what is shared or what the per-app files missed.

# OS
.DS_Store

# Editor / tooling
.idea/
.vscode/
*.swp

# Node — belt and braces; per-app .gitignore files also cover these
node_modules/
dist/
.vite/

# TypeScript incremental build state. These were committed in the dashboard
# before the monorepo migration; they are machine-local build artifacts.
*.tsbuildinfo

# Python — packages/argentum-python is a source tree, not a build output.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets
.env
.env.local
.env.*.local

# Go binaries built into the tree by `make build` in apps/backend
apps/backend/api
apps/backend/worker
apps/backend/discord
apps/backend/eval
apps/backend/encrypt_secret

# Eval reports are per-run artefacts; the committed baseline lives in
# docs/coverage/eval-baseline.md
apps/backend/eval-report*.json
apps/backend/eval-docs-report*.json

# The document corpus (T-P13) is *generated* from
# apps/backend/internal/evaldocs/fixtures.go — `make eval-docs-fixtures`.
# Twelve PDFs in the tree would be twelve files nobody can diff, review or
# explain, and the first question anybody asks of a score is what is in the
# fixture. The manifest beside them, which holds the hand-checked ground truth,
# is tracked.
apps/backend/testdata/eval/documents/*.pdf

# Local scratch
*.log
